<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/exo_video_dialog_pro_layout"
        android:background="@drawable/ic_video_progress_bg"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/exo_video_dialog_pro_img"
            android:layout_width="36dp"
            android:layout_height="27dp"
            android:layout_marginTop="16dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@null"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/exo_video_dialog_pro_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/exo_video_dialog_pro_img"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
